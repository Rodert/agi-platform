# MySQL 配置（部署时必须改为随机强密码）
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=agi_platform
MYSQL_USER=agi
MYSQL_PASSWORD=change-this-database-password

# Redis 配置（留空表示无密码）
REDIS_PASSWORD=

# 部署应用统一 HTTP 入口（默认 3012）
HTTP_PORT=3012
TZ=Asia/Shanghai

# JWT 签名密钥（至少 32 个随机字符）
JWT_SECRET=change-this-to-a-random-secret-with-at-least-32-characters

# 发布到镜像仓库后的应用镜像名称和标签
APP_IMAGE=ghcr.io/rodert/agi-platform:latest
UPDATE_IMAGE_REPOSITORY=ghcr.io/rodert/agi-platform

# 后台一键更新（仅超级管理员可用）。启用后更新代理会访问 Docker Socket。
UPDATE_ENABLED=false
# UPDATE_AGENT_TOKEN=replace-with-a-long-random-token
