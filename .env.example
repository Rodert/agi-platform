# MySQL 配置（部署时必须改为随机强密码）
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=agi_platform
MYSQL_USER=agi
MYSQL_PASSWORD=change-this-database-password

# Redis 配置（留空表示无密码）
REDIS_PASSWORD=

# 部署应用统一 HTTP 入口（默认 3012）
HTTP_PORT=3012
TZ=Asia/Shanghai

# JWT 签名密钥（至少 32 个随机字符）
JWT_SECRET=change-this-to-a-random-secret-with-at-least-32-characters

# 首次启动时创建的超级管理员。账号已存在时不会被环境变量重置。
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change-this-super-admin-password-with-at-least-8-characters
SUPER_ADMIN_NAME=超级管理员

# 发布到镜像仓库后的应用镜像名称和标签
APP_IMAGE=ghcr.io/rodert/agi-platform:latest
UPDATE_IMAGE_REPOSITORY=ghcr.io/rodert/agi-platform

# 后台一键更新默认开启，更新代理可访问 Docker Socket；生产环境务必替换令牌。
UPDATE_ENABLED=true
UPDATE_AGENT_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# 自动启用更新代理，正常执行 docker compose up -d 即可。
COMPOSE_PROFILES=update

# GitHub Release 检查在后端执行，默认每小时最多请求一次。
# 可选：为 GitHub 创建只读 fine-grained token（Contents: Read），避免匿名 API 限流。
# GITHUB_TOKEN=github_pat_xxx
