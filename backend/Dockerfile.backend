# AGI Platform 后端服务
FROM golang:1.23-alpine AS backend-builder

WORKDIR /app

# 复制 go mod 文件
COPY go.mod go.sum ./
RUN go mod download

# 复制源码
COPY . .

# 编译
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/bin/api cmd/api/main.go
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/bin/worker cmd/worker/main.go

# 运行阶段
FROM alpine:latest

WORKDIR /app

# 安装必要的依赖
RUN apk --no-cache add ca-certificates tzdata wget

# 设置时区
ENV TZ=Asia/Shanghai

# 复制编译好的二进制文件
COPY --from=backend-builder /app/bin/api /app/api
COPY --from=backend-builder /app/bin/worker /app/worker
COPY --from=backend-builder /app/configs /app/configs

# 创建上传目录
RUN mkdir -p /app/uploads

# 暴露端口
EXPOSE 8080

# 默认运行 API（可以通过命令覆盖）
CMD ["/app/api"]
