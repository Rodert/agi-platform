# 服务配置
APP_NAME=agi-platform
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=agi_platform
DB_CHARSET=utf8mb4

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_HOURS=168

# 对象存储配置（MinIO/OSS）
STORAGE_TYPE=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=agi-platform
STORAGE_USE_SSL=false
STORAGE_CDN_URL=http://localhost:9000

# 注意：邮箱配置、支付配置、AI模型配置已移至数据库
# 请在管理后台的"系统配置"中进行配置
# 对应数据库表: email_config, payment_channels, ai_models

# 系统配置
MAX_UPLOAD_SIZE=5242880
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60

# Worker 配置
WORKER_CONCURRENCY=10
WORKER_QUEUE_NAME=agi:tasks
