# 服务配置
APP_NAME=agi-platform
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=agi_platform
DB_CHARSET=utf8mb4

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_HOURS=168

# 首次启动时创建的超级管理员。账号已存在时不会被环境变量重置。
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change-this-super-admin-password-with-at-least-8-characters
SUPER_ADMIN_NAME=超级管理员

# 注意：对象存储、邮箱配置、支付配置、AI模型配置已移至数据库
# 请在管理后台的"系统配置"中进行配置
# 对应数据库表: storage_configs, email_config, payment_channels, ai_models

# 系统配置
MAX_UPLOAD_SIZE=5242880
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60

# Worker 配置
WORKER_CONCURRENCY=10
WORKER_QUEUE_NAME=agi:tasks
WORKER_IMAGE_CONCURRENCY=8
WORKER_VIDEO_CONCURRENCY=2
WORKER_IMAGE_REDIS_STREAM=agi:stream:images
WORKER_VIDEO_REDIS_STREAM=agi:stream:videos
