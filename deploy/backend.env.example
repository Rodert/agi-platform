# Copy this file to deploy/backend.env on the server, then fill real secrets.

MYSQL_ROOT_PASSWORD=change-this-mysql-password
MYSQL_DATABASE=agi_platform

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_SECONDS=604800
REGISTER_GIFT_CREDITS=100

# Keep the backend port private and put nginx/Caddy in front of it.
SERVER_BIND=127.0.0.1
SERVER_PORT=18082

STORAGE_PROVIDER=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=agi-platform-dev-1257142189
COS_REGION=ap-guangzhou
COS_PUBLIC_BASE_URL=https://agi-platform-dev-1257142189.cos.ap-guangzhou.myqcloud.com
COS_UPLOAD_PREFIX=
